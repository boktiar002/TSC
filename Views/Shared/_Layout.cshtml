@{
    var route = ViewContext.RouteData.Values;
    var area = route["area"]?.ToString() ?? "";
    var controller = route["controller"]?.ToString() ?? "";

    // "active" for the nav item whose area/controller we are currently in
    string On(string a, params string[] controllers) =>
        area == a && controllers.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TSC Teacher Student Care</title>
    <link rel="icon" type="image/png" href="~/img/tsc-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark tsc-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand py-1" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="tsc-brand-mark"><img src="~/img/tsc-logo.png" alt="TSC logo" /></span>
                    <span>
                        TSC
                        <span class="tsc-brand-sub">Teacher Student Care</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#tscNav" aria-controls="tscNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="tscNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @On("Admin", "Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @On("Admin", "Students", "Teachers")" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-people me-1"></i>People
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Students" asp-action="Index"><i class="bi bi-person-vcard me-2"></i>Students</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Students" asp-action="Index" asp-route-archived="true"><i class="bi bi-archive me-2"></i>Archived students</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Teachers" asp-action="Index"><i class="bi bi-person-workspace me-2"></i>Teachers</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @On("Admin", "Classes", "Subjects", "Exams")" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-journal-bookmark me-1"></i>Academics
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Classes" asp-action="Index"><i class="bi bi-collection me-2"></i>Classes</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Subjects" asp-action="Index"><i class="bi bi-book me-2"></i>Subjects</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Exams" asp-action="Index"><i class="bi bi-clipboard-check me-2"></i>Exams &amp; results</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Exams" asp-action="Progress"><i class="bi bi-trophy me-2"></i>Class progress</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @On("Admin", "Attendance")" asp-area="Admin" asp-controller="Attendance" asp-action="Index">
                                    <i class="bi bi-calendar2-check me-1"></i>Attendance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @On("Admin", "Payments")" asp-area="Admin" asp-controller="Payments" asp-action="Index">
                                    <i class="bi bi-cash-coin me-1"></i>Fees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @On("Admin", "Notices")" asp-area="Admin" asp-controller="Notices" asp-action="Index">
                                    <i class="bi bi-megaphone me-1"></i>Notices
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(area == "Teacher" && route["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-area="Teacher" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>My dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(area == "Teacher" && route["action"]?.ToString() == "Attendance" ? "active" : "")"
                                   asp-area="Teacher" asp-controller="Home" asp-action="Attendance">
                                    <i class="bi bi-calendar2-check me-1"></i>Attendance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Teacher" asp-controller="Home" asp-action="Exams">
                                    <i class="bi bi-clipboard-check me-1"></i>Exams &amp; marks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Teacher" asp-controller="Home" asp-action="Progress">
                                    <i class="bi bi-trophy me-1"></i>Results
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Teacher" asp-controller="Home" asp-action="Notices">
                                    <i class="bi bi-megaphone me-1"></i>Notices
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(area == "Student" && route["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-area="Student" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>My dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Student" asp-controller="Home" asp-action="Results">
                                    <i class="bi bi-graph-up-arrow me-1"></i>Results
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Student" asp-controller="Home" asp-action="Attendance">
                                    <i class="bi bi-calendar2-check me-1"></i>Attendance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Student" asp-controller="Home" asp-action="Fees">
                                    <i class="bi bi-cash-coin me-1"></i>Fees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Student" asp-controller="Home" asp-action="Notices">
                                    <i class="bi bi-megaphone me-1"></i>Notices
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["NewLogin"] is string newLogin && newLogin.Contains('|'))
            {
                var parts = newLogin.Split('|', 2);

                <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                    <i class="bi bi-key-fill"></i>
                    <div>
                        <strong>Write this down now.</strong>
                        The password is hashed on save and cannot be shown again.
                        <dl class="row mb-0 mt-2">
                            <dt class="col-sm-2">Email</dt>
                            <dd class="col-sm-10 mb-1 d-flex align-items-center gap-2">
                                <code id="tscNewEmail">@parts[0]</code>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-copy="#tscNewEmail">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </dd>
                            <dt class="col-sm-2">Password</dt>
                            <dd class="col-sm-10 mb-0 d-flex align-items-center gap-2">
                                <code id="tscNewPassword">@parts[1]</code>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-copy="#tscNewPassword">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </dd>
                        </dl>
                        <div class="small mt-2">
                            The password is case-sensitive and contains one symbol. Copy it rather than retyping it.
                        </div>
                    </div>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="tsc-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year TSC Teacher Student Care &middot; All rights reserved</span>
            <span class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
