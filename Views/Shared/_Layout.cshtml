@using Microsoft.AspNetCore.Identity
@using TSC.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    var nav = NavMenu.For(User);
    var signedIn = SignInManager.IsSignedIn(User) && nav.Count > 0;

    var displayName = User.Identity?.Name ?? "";

    // Every role they hold, not just the first. The person running the centre is also one of
    // its teachers, and showing only "Administrator" hid half of what they could reach.
    var held = new[] { ("Admin", "Administrator"), ("Teacher", "Teacher"), ("Student", "Student") }
        .Where(r => User.IsInRole(r.Item1))
        .Select(r => r.Item2)
        .ToList();

    var roleName = held.Count == 0 ? "Member" : string.Join(" · ", held);

    var initial = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "?";

    var route = ViewContext.RouteData.Values;
    var here = (route["area"]?.ToString() ?? "", route["controller"]?.ToString() ?? "");

    // The bottom bar follows whichever area they are standing in, so a teacher-admin reading
    // their own class pages gets teaching tabs rather than office ones.
    var areaNow = route["area"]?.ToString() ?? "";

    var bottom = nav.Where(i => i.OnBottomBar && i.Area == areaNow).Take(4).ToList();

    if (bottom.Count == 0)
        bottom = nav.Where(i => i.OnBottomBar).Take(4).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#102133" />
    <title>@ViewData["Title"] - TSC Teacher Student Care</title>
    <link rel="icon" type="image/png" href="~/img/tsc-icon.png" />
    <link rel="apple-touch-icon" href="~/img/tsc-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "tsc-app" : "tsc-public")">

@if (signedIn)
{
    <!-- Desktop sidebar. Off-canvas on phones, where it is opened by the top bar's menu button. -->
    <aside class="tsc-sidebar" id="tscSidebar">
        <a class="tsc-sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="tsc-brand-mark"><img src="~/img/tsc-logo-master.jpg" alt="" /></span>
            <span>
                TSC
                <span class="tsc-brand-sub">Teacher Student Care</span>
            </span>
        </a>

        <nav class="tsc-nav">
            <partial name="_NavLinks" model="nav" />
        </nav>

        <div class="tsc-sidebar-foot">
            <a class="tsc-nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                <i class="bi bi-person-gear"></i><span>My account</span>
            </a>

            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="tsc-nav-link tsc-nav-signout">
                    <i class="bi bi-box-arrow-right"></i><span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="tsc-scrim" id="tscScrim" hidden></div>

    <div class="tsc-main">

        <header class="tsc-topbar">
            <button type="button" class="tsc-menu-btn" id="tscMenuBtn"
                    aria-label="Open menu" aria-controls="tscSidebar" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>

            <div class="tsc-topbar-title">@ViewData["Title"]</div>

            <div class="dropdown">
                <button class="tsc-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="tsc-avatar">@initial</span>
                    <span class="tsc-user-text d-none d-md-block">
                        <span class="tsc-user-name">@displayName</span>
                        <span class="tsc-user-role">@roleName</span>
                    </span>
                    <i class="bi bi-chevron-down d-none d-md-block"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li class="px-3 py-2">
                        <div class="tsc-role">@roleName</div>
                        <div class="fw-semibold text-truncate" style="max-width: 15rem;">@displayName</div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="bi bi-person-gear me-2"></i>My account
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                            <i class="bi bi-shield-lock me-2"></i>Change password
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Sign out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main role="main" class="tsc-content">
            <partial name="_Flash" />
            @RenderBody()
        </main>

        <!-- Thumb-reach navigation. The office runs this one-handed from a phone, where a
             hamburger at the top of the screen is the hardest place to reach. -->
        <nav class="tsc-bottombar">
            @foreach (var item in bottom)
            {
                var on = here == (item.Area, item.Controller);

                <a class="tsc-bottombar-link @(on ? "active" : "")"
                   asp-area="@item.Area" asp-controller="@item.Controller" asp-action="@item.Action">
                    <i class="bi @item.Icon"></i>
                    <span>@item.Short</span>
                </a>
            }

            <button type="button" class="tsc-bottombar-link" id="tscMoreBtn">
                <i class="bi bi-three-dots"></i>
                <span>More</span>
            </button>
        </nav>

    </div>
}
else
{
    <header class="tsc-public-bar">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="tsc-sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="tsc-brand-mark"><img src="~/img/tsc-mark.png" alt="" /></span>
                <span>
                    TSC
                    <span class="tsc-brand-sub">Teacher Student Care</span>
                </span>
            </a>

            @if (SignInManager.IsSignedIn(User))
            {
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-outline-light btn-sm px-3">Sign out</button>
                </form>
            }
            else
            {
                <a class="btn btn-light btn-sm px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
                </a>
            }
        </div>
    </header>

    <main role="main" class="tsc-public-main">
        <div class="container">
            <partial name="_Flash" />
            @RenderBody()
        </div>
    </main>

    <footer class="tsc-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year TSC Teacher Student Care &middot; All rights reserved</span>
            <span class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
