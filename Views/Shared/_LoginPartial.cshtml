@using Microsoft.AspNetCore.Identity
@using TSC.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-lg-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var name = User.Identity?.Name ?? "";
        var role = User.IsInRole("Admin") ? "Administrator"
            : User.IsInRole("Teacher") ? "Teacher"
            : User.IsInRole("Student") ? "Student"
            : "Member";

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="tsc-avatar">@(name.Length > 0 ? char.ToUpperInvariant(name[0]).ToString() : "?")</span>
                <span class="d-lg-none d-xl-inline text-truncate" style="max-width: 14rem;">@name</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-lg-end">
                <li class="px-2 py-1">
                    <div class="tsc-role">@role</div>
                    <div class="text-truncate" style="max-width: 15rem;">@name</div>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person-gear me-2"></i>My account
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                        <i class="bi bi-shield-lock me-2"></i>Change password
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
            </a>
        </li>
    }
</ul>
