@model TSC.Models.RollCall

@*
    The tap sheet, shared by the office (/Admin/Attendance) and the teacher
    (/Teacher/Home/Attendance). The form posts to Toggle on whichever controller rendered it.
*@

<div class="tsc-roll-bar card shadow-sm mb-2">
    <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <div>
            <strong>@ViewBag.RollCallTitle</strong>
            <div class="text-muted small">@Model.Date.ToString("dddd, dd MMM yyyy")</div>
        </div>

        <div class="text-end">
            <div class="fs-4 fw-semibold lh-1">
                <span id="presentCount">@Model.PresentCount</span><span class="text-muted">/@Model.Roster.Count</span>
            </div>
            <div class="text-muted small">present</div>
        </div>
    </div>
</div>

<div class="list-group shadow-sm">
    @foreach (var student in Model.Roster)
    {
        var isPresent = Model.Recorded.TryGetValue(student.Id, out var p) && p;

        <div class="list-group-item tsc-roll-row @(isPresent ? "is-present" : "")">
            <div class="tsc-roll-name">
                @student.FullName
                <div class="text-muted small">@student.StudentId</div>
            </div>

            <form asp-action="Toggle" method="post" class="tsc-roll-form">
                <input type="hidden" name="studentId" value="@student.Id" />
                <input type="hidden" name="schoolClassId" value="@Model.SchoolClassId" />
                <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />

                <button type="submit" class="btn tsc-roll-btn @(isPresent ? "btn-success" : "btn-outline-secondary")">
                    <i class="bi @(isPresent ? "bi-check-lg" : "bi-dash-lg")"></i>
                    <span>@(isPresent ? "Present" : "Absent")</span>
                </button>
            </form>
        </div>
    }
</div>

<p class="text-muted small mt-3">
    Nothing else to press &mdash; what you see here is what is saved.
</p>
