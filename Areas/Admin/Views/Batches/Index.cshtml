@model IEnumerable<TSC.Models.Batch>

@{
    ViewData["Title"] = "Batches";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1>Batches</h1>
            <p class="text-muted">Manage coaching batches.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Batch
        </a>
    </div>

        @if (!Model.Any())
    {
        <div class="alert alert-info">
            No batches created yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var batch in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4>@batch.Name</h4>

                            @if (!string.IsNullOrWhiteSpace(batch.Description))
                            {
                                <p class="text-muted">
                                    @batch.Description
                                </p>
                            }

                            <hr />

                            <p>
                                <strong>Students:</strong>
                                @batch.Students.Count
                            </p>

                            <p>
                                <strong>Subjects:</strong>
                                @batch.BatchSubjects.Count
                            </p>

                            <p>
                                <strong>Monthly fee:</strong>
                                @(batch.MonthlyFee > 0 ? batch.MonthlyFee.ToString("0.##") : "not set")
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@batch.Id"
                               class="btn btn-outline-primary">
                                Manage Batch
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@batch.Id"
                               class="btn btn-outline-secondary">
                                Edit
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>