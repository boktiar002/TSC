@model TSC.Models.Batch

@{
    ViewData["Title"] = "Batch Details";
    var availableSubjects = (IEnumerable<TSC.Models.Subject>)ViewBag.AvailableSubjects;
    var teachers = (IEnumerable<TSC.Models.Teacher>)ViewBag.Teachers;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>@Model.Name</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0">@Model.Description</p>
        }
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

<div class="row">

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <strong>Students</strong>
                <span class="badge bg-secondary float-end">@Model.Students.Count</span>
            </div>
            <div class="card-body">

                @if (!Model.Students.Any())
                {
                    <p class="text-muted mb-0">No students assigned to this batch yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>ID</th><th>Name</th><th>Class</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students.OrderBy(s => s.FullName))
                            {
                                <tr>
                                    <td>@student.StudentId</td>
                                    <td>
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id">
                                            @student.FullName
                                        </a>
                                    </td>
                                    <td>@student.ClassLevel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <strong>Subjects &amp; Teachers</strong>
                <span class="badge bg-secondary float-end">@Model.BatchSubjects.Count</span>
            </div>
            <div class="card-body">

                @if (!Model.BatchSubjects.Any())
                {
                    <p class="text-muted">No subjects assigned yet.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>Subject</th><th>Teacher</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BatchSubjects.OrderBy(bs => bs.Subject?.Name))
                            {
                                <tr>
                                    <td>@item.Subject?.Name</td>
                                    <td>@item.Teacher?.FullName</td>
                                    <td class="text-end">
                                        <form asp-action="RemoveSubject" asp-route-id="@Model.Id" method="post"
                                              onsubmit="return confirm('Remove @item.Subject?.Name from @Model.Name?');">
                                            <input type="hidden" name="batchSubjectId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <hr />

                @if (!availableSubjects.Any() || !teachers.Any())
                {
                    <p class="text-muted mb-0">
                        @if (!teachers.Any())
                        {
                            <text>Add a <a asp-controller="Teachers" asp-action="Index">teacher</a> before assigning subjects.</text>
                        }
                        else
                        {
                            <text>Every <a asp-controller="Subjects" asp-action="Index">subject</a> is already assigned to this batch.</text>
                        }
                    </p>
                }
                else
                {
                    <form asp-action="AssignSubject" asp-route-id="@Model.Id" method="post" class="row g-2">
                        <div class="col-sm-5">
                            <select name="subjectId" class="form-select" required
                                    asp-items="@(new SelectList(availableSubjects, "Id", "Name"))">
                                <option value="">Subject...</option>
                            </select>
                        </div>

                        <div class="col-sm-5">
                            <select name="teacherId" class="form-select" required
                                    asp-items="@(new SelectList(teachers, "Id", "FullName"))">
                                <option value="">Teacher...</option>
                            </select>
                        </div>

                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary w-100">Assign</button>
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>

</div>
