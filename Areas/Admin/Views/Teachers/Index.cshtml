@model IEnumerable<TSC.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";

    var adminIds = (HashSet<string>)ViewBag.AdminUserIds;
    var adminCount = (int)ViewBag.AdminCount;
    var myUserId = ViewBag.MyUserId as string;
}

<div class="tsc-page-head">
    <div>
        <h1>Teachers</h1>
        <p class="text-muted mb-0">Manage teaching staff, what each one teaches, and who runs the office.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">+ Add Teacher</a>
</div>

@if (adminCount < 2)
{
    <div class="alert alert-warning d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            <strong>Only one admin.</strong> If that person is away or loses their password,
            nobody can take fees, call the roll or publish results. Make a second teacher an
            admin with the <span class="badge bg-secondary">Make admin</span> button below.
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>No teachers yet</h5>
                <p class="text-muted">Add a teacher to start assigning subjects to classes.</p>
                <a asp-action="Create" class="btn btn-primary">Add Teacher</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Teacher ID</th>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Specialization</th>
                            <th>Phone</th>
                            <th>Teaches</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            var isAdmin = teacher.UserId != null && adminIds.Contains(teacher.UserId);
                            var isMe = teacher.UserId != null && teacher.UserId == myUserId;

                            <tr>
                                <td><strong>@teacher.TeacherId</strong></td>
                                <td>
                                    @teacher.FullName
                                    @if (isMe)
                                    {
                                        <span class="text-muted small">(you)</span>
                                    }
                                </td>
                                <td>
                                    @if (isAdmin)
                                    {
                                        <span class="tsc-pill is-admin">
                                            <i class="bi bi-shield-check"></i>Admin &amp; teacher
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tsc-pill">Teacher</span>
                                    }
                                </td>
                                <td>@teacher.Specialization</td>
                                <td>@teacher.Phone</td>
                                <td>
                                    @if (!teacher.ClassSubjects.Any())
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                    else
                                    {
                                        @foreach (var bs in teacher.ClassSubjects)
                                        {
                                            <span class="badge bg-light text-dark border me-1">
                                                @bs.Subject?.Name &middot; @bs.SchoolClass?.Name
                                            </span>
                                        }
                                    }
                                </td>
                                @* Only the decision this page exists for stays on the row. Five
                                   buttons in a table cell wrapped into a ragged staircase, so
                                   the housekeeping lives behind a menu. *@
                                <td>
                                    <div class="tsc-row-actions">
                                    @if (teacher.UserId == null)
                                    {
                                        <form asp-action="CreateLogin" asp-route-id="@teacher.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                                    title="Signs in with Teacher ID @teacher.TeacherId">
                                                <i class="bi bi-person-plus"></i> Create login
                                            </button>
                                        </form>
                                    }
                                    else if (isAdmin)
                                    {
                                        <form asp-action="RemoveAdmin" asp-route-id="@teacher.Id" method="post"
                                              onsubmit="return confirm('Take admin away from @teacher.FullName? They keep their teaching pages but lose the office.');">
                                            <button type="submit" class="btn btn-sm btn-outline-warning"
                                                    title="Remove office access, keep teaching access">
                                                <i class="bi bi-shield-slash"></i> Remove admin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="MakeAdmin" asp-route-id="@teacher.Id" method="post"
                                              onsubmit="return confirm('Make @teacher.FullName an admin? They will be able to manage students, fees, exams, notices and logins.');">
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    title="Give this teacher the whole office as well">
                                                <i class="bi bi-shield-plus"></i> Make admin
                                            </button>
                                        </form>
                                    }

                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                                data-bs-toggle="dropdown" aria-expanded="false"
                                                aria-label="More actions for @teacher.FullName">
                                            <i class="bi bi-three-dots"></i>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@teacher.Id">
                                                    <i class="bi bi-pencil me-2"></i>Edit details
                                                </a>
                                            </li>

                                            @if (teacher.UserId != null)
                                            {
                                                <li>
                                                    <form asp-action="ResetLogin" asp-route-id="@teacher.Id" method="post"
                                                          onsubmit="return confirm('Issue a new password for @teacher.FullName? The old one stops working.');">
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-key me-2"></i>New password
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="RemoveLogin" asp-route-id="@teacher.Id" method="post"
                                                          onsubmit="return confirm('Remove @teacher.FullName\'s login? They lose access to the portal.');">
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-link-45deg me-2"></i>Remove login
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            <li><hr class="dropdown-divider" /></li>

                                            <li>
                                                <form asp-action="Delete" asp-route-id="@teacher.Id" method="post"
                                                      onsubmit="return confirm('Delete @teacher.FullName?');">
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>Delete teacher
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
