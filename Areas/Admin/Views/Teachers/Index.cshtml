@model IEnumerable<TSC.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>Teachers</h1>
        <p class="text-muted mb-0">Manage teaching staff and see what each one teaches.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">+ Add Teacher</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>No teachers yet</h5>
                <p class="text-muted">Add a teacher to start assigning subjects to batches.</p>
                <a asp-action="Create" class="btn btn-primary">Add Teacher</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Teacher ID</th>
                            <th>Name</th>
                            <th>Specialization</th>
                            <th>Phone</th>
                            <th>Teaches</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr>
                                <td><strong>@teacher.TeacherId</strong></td>
                                <td>@teacher.FullName</td>
                                <td>@teacher.Specialization</td>
                                <td>@teacher.Phone</td>
                                <td>
                                    @if (!teacher.BatchSubjects.Any())
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                    else
                                    {
                                        @foreach (var bs in teacher.BatchSubjects)
                                        {
                                            <span class="badge bg-light text-dark border me-1">
                                                @bs.Subject?.Name &middot; @bs.Batch?.Name
                                            </span>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (teacher.UserId != null)
                                    {
                                        <span class="badge bg-success me-1">Login</span>

                                        <form asp-action="ResetLogin" asp-route-id="@teacher.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Issue a new password for @teacher.FullName? The old one stops working.');">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Issue a new password">
                                                <i class="bi bi-key"></i> New password
                                            </button>
                                        </form>

                                        <form asp-action="RemoveLogin" asp-route-id="@teacher.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Remove this login?');">
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Unlink</button>
                                        </form>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(teacher.Email))
                                    {
                                        <form asp-action="CreateLogin" asp-route-id="@teacher.Id" method="post"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Create login</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small me-1" title="Add an email first">No email</span>
                                    }

                                    <a asp-action="Edit" asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>

                                    <form asp-action="Delete" asp-route-id="@teacher.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete @teacher.FullName?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
