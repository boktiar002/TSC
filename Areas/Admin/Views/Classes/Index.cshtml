@model IEnumerable<TSC.Models.SchoolClass>

@{
    ViewData["Title"] = "Classes";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1>Classes</h1>
            <p class="text-muted">Manage coaching classes.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Class
        </a>
    </div>

        @if (!Model.Any())
    {
        <div class="alert alert-info">
            No classes created yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var schoolClass in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4>@schoolClass.Name</h4>

                            @if (!string.IsNullOrWhiteSpace(schoolClass.Description))
                            {
                                <p class="text-muted">
                                    @schoolClass.Description
                                </p>
                            }

                            <hr />

                            <p>
                                <strong>Students:</strong>
                                @schoolClass.Students.Count
                            </p>

                            <p>
                                <strong>Subjects:</strong>
                                @schoolClass.ClassSubjects.Count
                            </p>

                            <p>
                                <strong>Monthly fee:</strong>
                                @(schoolClass.MonthlyFee > 0 ? schoolClass.MonthlyFee.ToString("0.##") : "not set")
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@schoolClass.Id"
                               class="btn btn-outline-primary">
                                Manage Class
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@schoolClass.Id"
                               class="btn btn-outline-secondary">
                                Edit
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>