@model IEnumerable<TSC.Models.Attendance>

@{
    var student = (TSC.Models.Student)ViewBag.Student;
    ViewData["Title"] = $"Attendance — {student.FullName}";

    var total = Model.Count();
    var presentDays = Model.Count(a => a.IsPresent);
    var rate = total == 0 ? 0 : presentDays * 100 / total;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@student.FullName</h1>
        <p class="text-muted mb-0">@student.StudentId &middot; @student.Batch?.Name</p>
    </div>

    <a asp-action="Index" asp-route-batchId="@student.BatchId" class="btn btn-secondary">Back to sheet</a>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Attendance rate</h6>
                <p class="display-6 mb-0">@rate%</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Present</h6>
                <p class="display-6 mb-0">@presentDays</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Days recorded</h6>
                <p class="display-6 mb-0">@total</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (total == 0)
        {
            <p class="text-muted mb-0">No attendance recorded for this student yet.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Date</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.Date.ToString("ddd, dd MMM yyyy")</td>
                            <td>
                                @if (record.IsPresent)
                                {
                                    <span class="badge bg-success">Present</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Absent</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>
