@using TSC.Areas.Admin.Controllers
@model IReadOnlyList<FollowupRow>

@{
    ViewData["Title"] = "Attendance Follow-up";

    var batches = (List<Batch>)ViewBag.Batches;
    var batchId = (int?)ViewBag.BatchId;
    var days = (int)ViewBag.Days;
    var threshold = (int)ViewBag.Threshold;
    var from = (DateOnly)ViewBag.From;
    var reviewed = (int)ViewBag.Reviewed;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>Attendance follow-up</h1>
        <p class="text-muted mb-0">
            Students below the attendance mark since @from.ToString("dd MMM yyyy").
            Ring the guardian before a run of absences becomes a dropout.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Daily sheet
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="batchId">Batch</label>
                <select class="form-select" id="batchId" name="batchId">
                    <option value="">All batches</option>
                    @foreach (var b in batches)
                    {
                        <option value="@b.Id" selected="@(b.Id == batchId)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="days">Look back</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="days" name="days" value="@days" min="7" max="365" />
                    <span class="input-group-text">days</span>
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="threshold">Flag below</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="threshold" name="threshold" value="@threshold" min="1" max="100" />
                    <span class="input-group-text">%</span>
                </div>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Show</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h5>Nobody to chase</h5>
            <p class="text-muted mb-0">
                @(reviewed == 0
                    ? "No attendance has been taken in this window yet."
                    : $"All {reviewed} students with a record are at or above {threshold}%.")
            </p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>@Model.Count student@(Model.Count == 1 ? "" : "s") to call</strong>
            <span class="text-muted small">out of @reviewed with attendance recorded</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Batch</th>
                        <th>Guardian</th>
                        <th>Phone</th>
                        <th class="text-end">Present</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Missed in a row</th>
                        <th>Last present</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@row.Student.Id"
                                   class="text-decoration-none">@row.Student.FullName</a>
                                <div class="text-muted small">@row.Student.StudentId &middot; Class @row.Student.ClassLevel</div>
                            </td>

                            <td>@row.Student.Batch?.Name</td>

                            <td>@(string.IsNullOrWhiteSpace(row.Student.GuardianName) ? "—" : row.Student.GuardianName)</td>

                            <td>
                                @{
                                    var phone = row.Student.GuardianPhone ?? row.Student.Phone;
                                }

                                @if (string.IsNullOrWhiteSpace(phone))
                                {
                                    <span class="text-danger small">No number on file</span>
                                }
                                else
                                {
                                    <a href="tel:@phone" class="text-decoration-none">@phone</a>
                                }
                            </td>

                            <td class="text-end">@row.DaysPresent / @row.DaysRecorded</td>

                            <td class="text-end">
                                <span class="badge bg-@(row.Rate < 50 ? "danger" : "warning")">@row.Rate.ToString("0.#")%</span>
                            </td>

                            <td class="text-end @(row.MissedInARow >= 3 ? "text-danger fw-semibold" : "")">
                                @row.MissedInARow
                            </td>

                            <td>@(row.LastPresent?.ToString("dd MMM yyyy") ?? "—")</td>

                            <td class="text-end">
                                <a asp-action="Student" asp-route-id="@row.Student.Id"
                                   class="btn btn-sm btn-outline-primary">Record</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
