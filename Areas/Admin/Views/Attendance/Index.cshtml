@model IEnumerable<TSC.Models.Student>

@{
    ViewData["Title"] = "Attendance";

    var batches = (IEnumerable<TSC.Models.Batch>)ViewBag.Batches;
    var batchId = (int?)ViewBag.BatchId;
    var date = (DateOnly)ViewBag.Date;
    var recorded = ViewBag.Recorded as Dictionary<int, bool> ?? new Dictionary<int, bool>();
    var alreadyTaken = ViewBag.AlreadyTaken as bool? ?? false;
}

<h1>Attendance</h1>
<p class="text-muted">Pick a batch and a date, then tick who showed up.</p>
<hr />

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-4">
        <label for="batchId" class="form-label">Batch</label>
        <select id="batchId" name="batchId" class="form-select" required
                asp-items="@(new SelectList(batches, "Id", "Name", batchId))">
            <option value="">Select a batch...</option>
        </select>
    </div>

    <div class="col-sm-3">
        <label for="date" class="form-label">Date</label>
        <input id="date" name="date" type="date" class="form-control" value="@date.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary w-100">Load</button>
    </div>
</form>

@if (batchId == null)
{
    <div class="alert alert-info">Choose a batch above to take attendance.</div>
}
else if (!Model.Any())
{
    <div class="alert alert-warning">
        This batch has no students yet.
        <a asp-controller="Students" asp-action="Create">Add one</a>.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@date.ToString("dddd, dd MMM yyyy")</strong>

            @if (alreadyTaken)
            {
                <span class="badge bg-success">Already recorded &mdash; saving again updates it</span>
            }
        </div>

        <div class="card-body">
            <form asp-action="Index" method="post">
                <input type="hidden" name="batchId" value="@batchId" />
                <input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")" />

                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 6rem;">
                                <div class="form-check mb-0">
                                    <input type="checkbox" id="toggleAll" class="form-check-input" />
                                    <label for="toggleAll" class="form-check-label small">All</label>
                                </div>
                            </th>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Record</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            var isPresent = recorded.TryGetValue(student.Id, out var p) && p;

                            <tr>
                                <td>
                                    <input type="checkbox" name="present" value="@student.Id"
                                           class="form-check-input present-box"
                                           checked="@isPresent" />
                                </td>
                                <td>@student.StudentId</td>
                                <td>@student.FullName</td>
                                <td>
                                    <a asp-action="Student" asp-route-id="@student.Id"
                                       class="small">History</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-primary">Save Attendance</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('toggleAll')?.addEventListener('change', function () {
            document.querySelectorAll('.present-box').forEach(b => b.checked = this.checked);
        });
    </script>
}
