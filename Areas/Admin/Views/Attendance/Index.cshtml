@model TSC.Models.RollCall?

@{
    ViewData["Title"] = "Attendance";

    var batches = (IEnumerable<TSC.Models.Batch>)ViewBag.Batches;
    var batchId = (int?)ViewBag.BatchId;
    var date = (DateOnly)ViewBag.Date;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Roll call</h1>
        <p class="text-muted mb-0">
            Everyone starts absent. Tap a name to mark them present, tap again to undo &mdash;
            each tap saves on its own.
        </p>
    </div>

    <a asp-action="Followup" class="btn btn-outline-primary">
        <i class="bi bi-telephone me-1"></i>Follow-up list
    </a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-7 col-sm-4">
        <label for="batchId" class="form-label">Batch</label>
        <select id="batchId" name="batchId" class="form-select" required
                asp-items="@(new SelectList(batches, "Id", "Name", batchId))">
            <option value="">Select a batch...</option>
        </select>
    </div>

    <div class="col-5 col-sm-3">
        <label for="date" class="form-label">Date</label>
        <input id="date" name="date" type="date" class="form-control" value="@date.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-12 col-sm-2">
        <button type="submit" class="btn btn-primary w-100">Load</button>
    </div>
</form>

@if (Model == null)
{
    <div class="alert alert-info">Choose a batch above to take attendance.</div>
}
else if (!Model.Roster.Any())
{
    <div class="alert alert-warning">
        This batch has no students yet.
        <a asp-controller="Students" asp-action="Create">Add one</a>.
    </div>
}
else
{
    <partial name="_RollCall" model="Model" />
}
