@model TSC.Models.Payment

@{
    ViewData["Title"] = "Record Payment";
    var students = (IEnumerable<TSC.Models.Student>)ViewBag.Students;
    var methods = (string[])ViewBag.Methods;
}

<h1>Record Payment</h1>
<p class="text-muted">The amount is prefilled with what's still outstanding; change it for a partial payment.</p>
<hr />

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId" class="form-select"
                        asp-items="@(students.Select(s => new SelectListItem(
                            $"{s.FullName} ({s.StudentId}) — {s.Batch?.Name}", s.Id.ToString())))">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ForMonth" class="form-label"></label>
                    <input asp-for="ForMonth" type="date" class="form-control" />
                    <div class="form-text">Any day in the month; it is stored as the 1st.</div>
                    <span asp-validation-for="ForMonth" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PaymentDate" class="form-label"></label>
                    <input asp-for="PaymentDate" type="date" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select"
                            asp-items="@(new SelectList(methods))">
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Note" class="form-label"></label>
                <textarea asp-for="Note" class="form-control" rows="2"
                          placeholder="Optional — receipt number, transaction id, etc."></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Record Payment</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
