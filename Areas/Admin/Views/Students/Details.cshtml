@model TSC.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="tsc-page-head">

    <div>
        <h1>@Model.FullName</h1>
        <p class="text-muted mb-0">
            Student ID: @Model.StudentId
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Exams" asp-action="ReportCard" asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-text me-1"></i>Report card
        </a>

        <a asp-controller="Attendance" asp-action="Student" asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Attendance
        </a>

        <a asp-controller="Payments" asp-action="Student" asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Fees
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>

</div>

@if (!Model.IsActive)
{
    <div class="alert alert-secondary d-flex align-items-start gap-2">
        <i class="bi bi-archive mt-1"></i>
        <div>
            <strong>Archived.</strong> @Model.FullName is off every roster and has no portal
            login. Their marks, attendance and fees below are kept as history — restore them
            from the archived list to put them back in the class.
        </div>
    </div>
}

<div class="row g-3 mb-3">

    <div class="col-md-6">

        <div class="card h-100">
            <div class="card-header">
                <strong>Academic Information</strong>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-5">
                        Student ID
                    </dt>

                    <dd class="col-sm-7">
                        @Model.StudentId
                    </dd>

                    <dt class="col-sm-5">
                        Batch
                    </dt>

                    <dd class="col-sm-7">
                        @(string.IsNullOrWhiteSpace(Model.Batch) ? "—" : Model.Batch)
                    </dd>

                    <dt class="col-sm-5">
                        Class
                    </dt>

                    <dd class="col-sm-7">
                        @Model.SchoolClass?.Name
                    </dd>

                </dl>

            </div>
        </div>

    </div>

    <div class="col-md-6">

        <div class="card h-100">
            <div class="card-header">
                <strong>Contact Information</strong>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-5">
                        Phone
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Phone
                    </dd>

                    <dt class="col-sm-5">
                        Email
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Email
                    </dd>

                    <dt class="col-sm-5">
                        Address
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Address
                    </dd>

                </dl>

            </div>
        </div>

    </div>

    <div class="col-md-6">

        <div class="card h-100">
            <div class="card-header">
                <strong>Guardian Information</strong>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-5">
                        Guardian
                    </dt>

                    <dd class="col-sm-7">
                        @Model.GuardianName
                    </dd>

                    <dt class="col-sm-5">
                        Guardian Phone
                    </dt>

                    <dd class="col-sm-7">
                        @Model.GuardianPhone
                    </dd>

                </dl>

            </div>
        </div>

    </div>

</div>

<div class="card">
    <div class="card-header"><strong>Portal login</strong></div>
    <div class="card-body">

        @if (Model.UserId != null)
        {
            var login = ViewBag.Login as TSC.Models.ApplicationUser;

            <p class="mb-3">
                <span class="badge bg-success">Active</span>
            </p>

            <div class="tsc-cred-fields mb-3">
                <div class="tsc-cred-field">
                    <span class="tsc-cred-label">Login ID</span>
                    <code id="stuLoginId">@(login?.UserName ?? Model.StudentId)</code>
                    <button type="button" class="tsc-icon-btn" data-copy="#stuLoginId"
                            aria-label="Copy login ID">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <div class="tsc-cred-field">
                    <span class="tsc-cred-label">Password</span>

                    @if (login?.IssuedPassword == null)
                    {
                        <span class="text-muted small">
                            Not stored &mdash; either the student changed it, or the account was
                            made before passwords were kept. Issue a new one to see it here.
                        </span>
                    }
                    else
                    {
                        <code class="tsc-secret" id="stuPw" data-secret="@login.IssuedPassword">••••••••</code>
                        <button type="button" class="tsc-icon-btn" data-reveal="#stuPw"
                                aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button type="button" class="tsc-icon-btn" data-copy-secret="#stuPw"
                                aria-label="Copy password">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    }
                </div>
            </div>

            <form asp-action="ResetLogin" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Issue a new password? The old one stops working.');">
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-key"></i> New password
                </button>
            </form>

            <form asp-action="RemoveLogin" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Remove @Model.FullName\'s login? They will lose access to the portal.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove login</button>
            </form>
        }
        else
        {
            <p class="text-muted">
                No login yet. Creating one lets @Model.FullName sign in to see their own
                results, attendance and fees. They will sign in with their Student ID,
                <code>@Model.StudentId</code> &mdash; no email address needed.
            </p>

            <form asp-action="CreateLogin" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i>Create login
                </button>
            </form>
        }

    </div>
</div>