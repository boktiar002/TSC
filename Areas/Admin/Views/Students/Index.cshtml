@model IEnumerable<TSC.Models.Student>

@{
    var archived = (bool)ViewBag.Archived;
    var archivedCount = (int)ViewBag.ArchivedCount;
    var query = (string?)ViewBag.Query;
    var schoolClassId = (int?)ViewBag.SchoolClassId;
    var schoolClasses = (List<TSC.Models.SchoolClass>)ViewBag.SchoolClasses;
    var filtered = !string.IsNullOrWhiteSpace(query) || schoolClassId > 0;

    ViewData["Title"] = archived ? "Archived Students" : "Students";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>@(archived ? "Archived Students" : "Students")</h1>
        <p class="text-muted mb-0">
            @(archived
                ? "Students who have left. Their marks, attendance and payments are kept."
                : "Manage all students of the coaching center.")
        </p>
    </div>

    <div>
        @if (archived)
        {
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to students</a>
        }
        else
        {
            @if (archivedCount > 0)
            {
                <a asp-action="Index" asp-route-archived="true" class="btn btn-outline-secondary">
                    <i class="bi bi-archive me-1"></i>Archived (@archivedCount)
                </a>
            }

            <a asp-action="Create" class="btn btn-primary ms-2"><i class="bi bi-plus-lg me-1"></i>Add student</a>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            @if (archived)
            {
                <input type="hidden" name="archived" value="true" />
            }

            <div class="col-md-5">
                <label class="form-label" for="q">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" id="q" name="q" value="@query"
                           placeholder="Name, student ID, phone or guardian" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="schoolClassId">Class</label>
                <select class="form-select" id="schoolClassId" name="schoolClassId">
                    <option value="">All classes</option>
                    @foreach (var b in schoolClasses)
                    {
                        <option value="@b.Id" selected="@(b.Id == schoolClassId)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>

                @if (filtered)
                {
                    <a asp-action="Index" asp-route-archived="@(archived ? "true" : null)"
                       class="btn btn-outline-secondary" title="Clear filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>@(filtered ? "No match" : archived ? "No archived students" : "No students found")</h5>

                @if (filtered)
                {
                    <p class="text-muted">Nothing matches that search. Try a different name, ID or phone number.</p>

                    <a asp-action="Index" asp-route-archived="@(archived ? "true" : null)" class="btn btn-outline-secondary">
                        Clear filters
                    </a>
                }
                else
                {
                    <p class="text-muted">Add your first student to get started.</p>

                    <a asp-action="Create" class="btn btn-primary">Add student</a>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">
                @Model.Count() student@(Model.Count() == 1 ? "" : "s")@(filtered ? " matching" : "")
            </p>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Class</th>
                            <th>Batch</th>
                            <th>Guardian</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@student.StudentId</strong>
                                </td>

                                <td>
                                    @student.FullName
                                </td>

                                <td>
                                    @student.SchoolClass?.Name
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(student.Batch))
                                    {
                                        <span class="text-muted" title="No batch set">&mdash;</span>
                                    }
                                    else
                                    {
                                        @student.Batch
                                    }
                                </td>

                                <td>
                                    @student.GuardianName
                                </td>

                                <td>
                                    @student.Phone
                                </td>

                                <td>
                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                        @if (archived)
                                        {
                                            <form asp-action="Restore" asp-route-id="@student.Id"
                                                  method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    Restore
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@student.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Remove
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>