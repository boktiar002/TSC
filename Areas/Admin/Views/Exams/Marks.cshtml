@model IEnumerable<TSC.Models.Student>

@{
    var exam = (TSC.Models.Exam)ViewBag.Exam;
    var paper = (TSC.Models.ExamSubject)ViewBag.Paper;
    var entered = (Dictionary<int, decimal>)ViewBag.Entered;

    ViewData["Title"] = $"Marks — {paper.Subject?.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>@exam.Name</h1>
        <p class="text-muted mb-0">@exam.SchoolClass?.Name &middot; @exam.ExamDate.ToString("dd MMM yyyy")</p>
    </div>

    <div>
        <a asp-action="Results" asp-route-id="@exam.Id" class="btn btn-outline-secondary">Results</a>
        <a asp-action="Details" asp-route-id="@exam.Id" class="btn btn-secondary">Back to papers</a>
    </div>
</div>

<ul class="nav nav-tabs mb-0">
    @foreach (var other in exam.ExamSubjects.OrderBy(es => es.Subject?.Name))
    {
        <li class="nav-item">
            <a class="nav-link @(other.SubjectId == paper.SubjectId ? "active" : "")"
               asp-action="Marks" asp-route-id="@exam.Id" asp-route-subjectId="@other.SubjectId">
                @other.Subject?.Name
            </a>
        </li>
    }
</ul>

<div class="card shadow-sm border-top-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <p class="text-muted mb-0">
                @exam.SchoolClass?.Name has no students yet.
                <a asp-controller="Students" asp-action="Create">Add one</a>.
            </p>
        }
        else
        {
            <p class="text-muted">
                Out of <strong>@paper.FullMarks.ToString("0.##")</strong>.
                Leave a box empty for a student who did not sit the paper.
            </p>

            <form asp-action="Marks" asp-route-id="@exam.Id" method="post">
                <input type="hidden" name="subjectId" value="@paper.SubjectId" />

                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th style="width: 10rem;">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            var score = entered.TryGetValue(student.Id, out var s)
                                ? s.ToString("0.##")
                                : "";

                            <tr>
                                <td>@student.StudentId</td>
                                <td>@student.FullName</td>
                                <td>
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <input type="number" name="score" value="@score"
                                           step="0.01" min="0" max="@paper.FullMarks"
                                           class="form-control form-control-sm" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-primary">Save Marks</button>
            </form>
        }

    </div>
</div>
