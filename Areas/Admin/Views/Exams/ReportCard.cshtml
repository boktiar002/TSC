@using Microsoft.AspNetCore.WebUtilities
@using TSC.Areas.Admin.Controllers
@model ReportCardModel

@{
    // Every number on this sheet comes off the model, which is the same one the PDF renders
    // from, so the printout and the download cannot drift apart.
    var student = Model.Student;
    var exams = Model.Exams;
    var chosen = Model.Chosen;
    var columns = Model.Columns;

    ViewData["Title"] = $"Report Card — {student.FullName}";

    var chosenIds = chosen.Select(e => e.Id).ToHashSet();

    // examIds repeats, which a route-value dictionary cannot express, so build the query string.
    var pdfUrl = QueryHelpers.AddQueryString(
        Url.Action("ReportCardPdf", new { id = student.Id })!,
        chosenIds.Select(i => new KeyValuePair<string, string?>("examIds", i.ToString())));
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 no-print">
    <div>
        <h1>Report card</h1>
        <p class="text-muted mb-0">Printable summary for the guardian.</p>
    </div>

    <div>
        <a asp-action="Progress" asp-route-schoolClassId="@student.SchoolClassId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Class progress
        </a>

        <a href="@pdfUrl" class="btn btn-outline-primary ms-2">
            <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
        </a>

        <button type="button" class="btn btn-primary ms-2" onclick="window.print();">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

@if (exams.Count > 1)
{
    <div class="card shadow-sm mb-4 no-print">
        <div class="card-body">
            <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label class="form-label">Exams on this card</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var exam in exams)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="examIds"
                                       value="@exam.Id" id="rc@(exam.Id)" checked="@chosenIds.Contains(exam.Id)" />
                                <label class="form-check-label" for="rc@(exam.Id)">@exam.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm tsc-sheet">
    <div class="card-body">

        <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
            <img src="~/img/tsc-logo.png" alt="TSC" style="width: 4.5rem;" />
            <div>
                <h2 class="mb-0">TSC &mdash; Teacher Student Care</h2>
                <div class="text-muted">Progress report @(chosen.Count == 1 ? $"— {chosen[0].Name}" : "")</div>
            </div>
            <div class="ms-auto text-end text-muted small">
                Issued @Clock.Today.ToString("dd MMM yyyy")
            </div>
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-2">Student</dt>
            <dd class="col-sm-4 mb-1"><strong>@student.FullName</strong> (@student.StudentId)</dd>

            <dt class="col-sm-2">Class &amp; batch</dt>
            <dd class="col-sm-4 mb-1">@student.SchoolClass?.Name@(string.IsNullOrWhiteSpace(student.Batch) ? "" : " · " + student.Batch)</dd>

            <dt class="col-sm-2">Guardian</dt>
            <dd class="col-sm-4 mb-1">@(string.IsNullOrWhiteSpace(student.GuardianName) ? "—" : student.GuardianName)</dd>

            <dt class="col-sm-2">Contact</dt>
            <dd class="col-sm-4 mb-1">@(student.GuardianPhone ?? student.Phone ?? "—")</dd>
        </dl>

        @if (!columns.Any())
        {
            <p class="text-muted">No papers have been marked for this class yet.</p>
        }
        else
        {
            <table class="table table-sm align-middle mb-4">
                <thead>
                    <tr>
                        <th>Exam</th>
                        <th>Paper</th>
                        <th class="text-end">Full marks</th>
                        <th class="text-end">Marks</th>
                        <th class="text-end">%</th>
                        <th class="text-center">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines())
                    {
                        <tr>
                            <td>
                                @line.ExamName
                                <div class="text-muted small">@line.ExamDate.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>@line.SubjectName</td>
                            <td class="text-end">@line.FullMarks.ToString("0.##")</td>
                            <td class="text-end">
                                @if (line.Score == null)
                                {
                                    <span class="text-danger">Absent</span>
                                }
                                else
                                {
                                    @line.Score.Value.ToString("0.##")
                                }
                            </td>
                            <td class="text-end">@line.Percent.ToString("0.#")%</td>
                            <td class="text-center">
                                <span class="badge bg-@Grading.Colour(line.GradeLetter)">@line.GradeLetter</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="2">Total</td>
                        <td class="text-end">@Model.FullMarks.ToString("0.##")</td>
                        <td class="text-end">@Model.Row.Total.ToString("0.##")</td>
                        <td class="text-end">@Model.Row.AveragePercent.ToString("0.#")%</td>
                        <td class="text-center">
                            <span class="badge bg-@Grading.Colour(Model.Grade.Letter)">@Model.Grade.Letter</span>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="row g-3 mb-4">
                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Merit position</div>
                        <div class="fs-4 fw-semibold">@Model.Place</div>
                        <div class="text-muted small">@(Model.Row.Rank == 0 ? "archived — not in the class ranking" : $"of {Model.ClassSize} in the class")</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Papers sat</div>
                        <div class="fs-4 fw-semibold">@Model.Row.PapersSat / @columns.Count</div>
                        <div class="text-muted small">absent counts as zero</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Attendance</div>
                        <div class="fs-4 fw-semibold">@(Model.AttendanceRate == null ? "—" : $"{Model.AttendanceRate}%")</div>
                        <div class="text-muted small">@Model.AttendancePresent of @Model.AttendanceDays days</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">@Model.ThisMonth.ToString("MMMM") fees</div>
                        <div class="fs-4 fw-semibold @(Model.Due > 0 ? "text-danger" : "text-success")">
                            @(Model.MonthlyFee <= 0 ? "—" : Model.Due > 0 ? Model.Due.ToString("0.##") + " due" : "Paid")
                        </div>
                        <div class="text-muted small">@Model.PaidThisMonth.ToString("0.##") of @Model.MonthlyFee.ToString("0.##") received</div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4 mt-2">
            <div class="col-md-8">
                <div class="text-muted small">Teacher's remark</div>
                <div class="border-bottom" style="height: 2.2rem;"></div>
                <div class="border-bottom mt-3" style="height: 2.2rem;"></div>
            </div>

            <div class="col-md-4 text-center align-self-end">
                <div class="border-top pt-1 mt-5">Guardian's signature</div>
            </div>
        </div>

    </div>
</div>
