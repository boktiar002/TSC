@model TSC.Models.ReportCardModel

@{
    var student = Model.Student;
    ViewData["Title"] = $"Report Card — {student.FullName}";

    var chosenIds = Model.Chosen.Select(e => e.Id).ToHashSet();
    var examIds = Model.Chosen.Select(e => e.Id).ToArray();
}

<div class="tsc-page-head no-print">
    <div>
        <h1>Report card</h1>
        <p class="text-muted mb-0">Printable summary for the guardian — or a PDF to send them.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Progress" asp-route-schoolClassId="@student.SchoolClassId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Class progress
        </a>

        <a asp-action="ReportCardPdf" asp-route-id="@student.Id" asp-route-examIds="@examIds"
           class="btn btn-outline-primary">
            <i class="bi bi-download me-1"></i>Download PDF
        </a>

        <button type="button" class="btn btn-primary" onclick="window.print();">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

@if (Model.Exams.Count > 1)
{
    <div class="card mb-3 no-print">
        <div class="card-body">
            <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label class="form-label">Exams on this card</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var exam in Model.Exams)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="examIds"
                                       value="@exam.Id" id="rc@(exam.Id)" checked="@chosenIds.Contains(exam.Id)" />
                                <label class="form-check-label" for="rc@(exam.Id)">@exam.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        </div>
    </div>
}

<div class="tsc-report">
    <div class="tsc-report-inner">

        <header class="tsc-report-head">
            <img class="tsc-report-logo" src="~/img/tsc-logo.png" alt="TSC" />

            <div class="tsc-report-ident">
                <div class="tsc-report-name">TSC &mdash; Teacher's Student Care</div>
                <div class="tsc-report-tag">Coaching centre &middot; Bangladesh</div>
            </div>

            <div class="tsc-report-meta">
                <div class="tsc-report-kicker">Progress report</div>
                <div class="tsc-report-exam">@Model.Title</div>
                <div class="tsc-report-date">Issued @TSC.Data.Clock.Today.ToString("dd MMM yyyy")</div>
            </div>
        </header>

        <section class="tsc-report-student">
            <dl>
                <dt>Student</dt>
                <dd class="is-strong">@student.FullName</dd>

                <dt>Student ID</dt>
                <dd>@student.StudentId</dd>

                <dt>Class &amp; batch</dt>
                <dd>@student.SchoolClass?.Name@(string.IsNullOrWhiteSpace(student.Batch) ? "" : " · " + student.Batch)</dd>
            </dl>

            <dl>
                <dt>Guardian</dt>
                <dd>@(string.IsNullOrWhiteSpace(student.GuardianName) ? "—" : student.GuardianName)</dd>

                <dt>Contact</dt>
                <dd>@(student.GuardianPhone ?? student.Phone ?? "—")</dd>

                <dt>Exams</dt>
                <dd>@string.Join(", ", Model.Chosen.Select(e => e.Name))</dd>
            </dl>
        </section>

        @if (!Model.Columns.Any())
        {
            <p class="text-muted fst-italic">No papers have been marked for this class yet.</p>
        }
        else
        {
            @* With one exam on the card its name is already in the masthead, and repeating it on
               every row only forces a five-line wrap on a phone. Then the column is just the
               date. With several exams it has to say which row belongs to which. *@
            var manyExams = Model.Chosen.Count > 1;

            <table class="tsc-report-table">
                <thead>
                    <tr>
                        <th>@(manyExams ? "Exam" : "Date")</th>
                        <th>Paper</th>
                        <th class="text-end">Full marks</th>
                        <th class="text-end">Marks</th>
                        <th class="text-end">%</th>
                        <th class="text-center">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines())
                    {
                        <tr>
                            <td>
                                @if (manyExams)
                                {
                                    <span class="fw-semibold">@line.ExamName</span>
                                    <span class="tsc-report-sub">@line.ExamDate.ToString("dd MMM yyyy")</span>
                                }
                                else
                                {
                                    <span>@line.ExamDate.ToString("dd MMM yyyy")</span>
                                }
                            </td>
                            <td>@line.SubjectName</td>
                            <td class="text-end">@line.FullMarks.ToString("0.##")</td>
                            <td class="text-end fw-semibold">
                                @if (line.Score == null)
                                {
                                    <span class="tsc-report-absent">Absent</span>
                                }
                                else
                                {
                                    @line.Score.Value.ToString("0.##")
                                }
                            </td>
                            <td class="text-end">@line.Percent.ToString("0.#")%</td>
                            <td class="text-center">
                                <span class="tsc-grade tsc-grade-@TSC.Models.Grading.Colour(line.GradeLetter)">@line.GradeLetter</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">Total</td>
                        <td class="text-end">@Model.FullMarks.ToString("0.##")</td>
                        <td class="text-end">@Model.Row.Total.ToString("0.##")</td>
                        <td class="text-end">@Model.Row.AveragePercent.ToString("0.#")%</td>
                        <td class="text-center">
                            <span class="tsc-grade tsc-grade-@TSC.Models.Grading.Colour(Model.Grade.Letter)">@Model.Grade.Letter</span>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <section class="tsc-report-stats">
                <div class="tsc-report-stat">
                    <span class="tsc-report-stat-label">Merit position</span>
                    <span class="tsc-report-stat-value">@Model.Place</span>
                    <span class="tsc-report-stat-note">
                        @(Model.Row.Rank == 0 ? "not in the class ranking" : $"of {Model.ClassSize} in the class")
                    </span>
                </div>

                <div class="tsc-report-stat">
                    <span class="tsc-report-stat-label">Papers sat</span>
                    <span class="tsc-report-stat-value">@Model.Row.PapersSat / @Model.Columns.Count</span>
                    <span class="tsc-report-stat-note">absent counts as zero</span>
                </div>

                <div class="tsc-report-stat">
                    <span class="tsc-report-stat-label">Attendance</span>
                    <span class="tsc-report-stat-value">@(Model.AttendanceRate == null ? "—" : $"{Model.AttendanceRate}%")</span>
                    <span class="tsc-report-stat-note">@Model.AttendancePresent of @Model.AttendanceDays days</span>
                </div>

                <div class="tsc-report-stat">
                    <span class="tsc-report-stat-label">GPA</span>
                    <span class="tsc-report-stat-value">@Model.Grade.Point.ToString("0.00")</span>
                    <span class="tsc-report-stat-note">grade @Model.Grade.Letter</span>
                </div>
            </section>

            @* Fees are the centre's business, not the guardian's report. Kept on screen for the
               office, dropped from the printed sheet and absent from the PDF entirely. *@
            <div class="alert alert-light border small no-print mb-0 mt-3">
                <strong>@Model.ThisMonth.ToString("MMMM") fees (office only):</strong>
                @if (Model.MonthlyFee <= 0)
                {
                    <text>no fee set for this class.</text>
                }
                else if (Model.Due > 0)
                {
                    <span class="text-danger fw-semibold">@Model.Due.ToString("0.##") due</span>
                    <text> &mdash; @Model.PaidThisMonth.ToString("0.##") of @Model.MonthlyFee.ToString("0.##") received.</text>
                }
                else
                {
                    <span class="text-success fw-semibold">paid in full</span>
                    <text> (@Model.PaidThisMonth.ToString("0.##")).</text>
                }
            </div>
        }

        <section class="tsc-report-sign">
            <div class="tsc-report-remark">
                <span class="tsc-report-stat-label">Teacher's remark</span>
                <span class="tsc-report-rule"></span>
                <span class="tsc-report-rule"></span>
            </div>

            <div class="tsc-report-signature">Guardian's signature</div>
            <div class="tsc-report-signature">Principal</div>
        </section>

        <footer class="tsc-report-foot">
            Computer-generated report &middot; TSC Teacher's Student Care &middot;
            issued @TSC.Data.Clock.Today.ToString("dd MMM yyyy")
        </footer>

    </div>
</div>
