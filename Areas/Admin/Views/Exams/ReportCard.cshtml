@using TSC.Areas.Admin.Controllers
@model ProgressRow

@{
    var student = (Student)ViewBag.Student;
    var exams = (List<Exam>)ViewBag.Exams;
    var chosen = (List<Exam>)ViewBag.Chosen;
    var columns = (List<(Exam Exam, ExamSubject Paper)>)ViewBag.Columns;
    var classSize = (int)ViewBag.ClassSize;
    var days = (int)ViewBag.AttendanceDays;
    var present = (int)ViewBag.AttendancePresent;
    var thisMonth = (DateOnly)ViewBag.ThisMonth;
    var fee = (decimal)ViewBag.MonthlyFee;
    var paid = (decimal)ViewBag.PaidThisMonth;
    var due = Math.Max(0, fee - paid);

    ViewData["Title"] = $"Report Card — {student.FullName}";

    var fullMarks = columns.Sum(c => c.Paper.FullMarks);
    var grade = Grading.For(Model.AveragePercent);
    var attendanceRate = days == 0 ? (decimal?)null : Math.Round(present * 100m / days, 1);

    var chosenIds = chosen.Select(e => e.Id).ToHashSet();

    string Place(int rank) => rank switch
    {
        1 => "1st", 2 => "2nd", 3 => "3rd", _ => $"{rank}th"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 no-print">
    <div>
        <h1>Report card</h1>
        <p class="text-muted mb-0">Printable summary for the guardian.</p>
    </div>

    <div>
        <a asp-action="Progress" asp-route-batchId="@student.BatchId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Batch progress
        </a>

        <button type="button" class="btn btn-primary ms-2" onclick="window.print();">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

@if (exams.Count > 1)
{
    <div class="card shadow-sm mb-4 no-print">
        <div class="card-body">
            <form method="get" class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label class="form-label">Exams on this card</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var exam in exams)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="examIds"
                                       value="@exam.Id" id="rc@(exam.Id)" checked="@chosenIds.Contains(exam.Id)" />
                                <label class="form-check-label" for="rc@(exam.Id)">@exam.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm tsc-sheet">
    <div class="card-body">

        <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
            <img src="~/img/tsc-logo.png" alt="TSC" style="width: 4.5rem;" />
            <div>
                <h2 class="mb-0">TSC &mdash; Teacher Student Care</h2>
                <div class="text-muted">Progress report @(chosen.Count == 1 ? $"— {chosen[0].Name}" : "")</div>
            </div>
            <div class="ms-auto text-end text-muted small">
                Issued @DateTime.Today.ToString("dd MMM yyyy")
            </div>
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-2">Student</dt>
            <dd class="col-sm-4 mb-1"><strong>@student.FullName</strong> (@student.StudentId)</dd>

            <dt class="col-sm-2">Class &amp; batch</dt>
            <dd class="col-sm-4 mb-1">Class @student.ClassLevel &middot; @student.Batch?.Name</dd>

            <dt class="col-sm-2">Guardian</dt>
            <dd class="col-sm-4 mb-1">@(string.IsNullOrWhiteSpace(student.GuardianName) ? "—" : student.GuardianName)</dd>

            <dt class="col-sm-2">Contact</dt>
            <dd class="col-sm-4 mb-1">@(student.GuardianPhone ?? student.Phone ?? "—")</dd>
        </dl>

        @if (!columns.Any())
        {
            <p class="text-muted">No papers have been marked for this batch yet.</p>
        }
        else
        {
            <table class="table table-sm align-middle mb-4">
                <thead>
                    <tr>
                        <th>Exam</th>
                        <th>Paper</th>
                        <th class="text-end">Full marks</th>
                        <th class="text-end">Marks</th>
                        <th class="text-end">%</th>
                        <th class="text-center">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < columns.Count; i++)
                    {
                        var column = columns[i];
                        var score = Model.Scores[i];
                        var percent = score == null ? 0 : Grading.Percentage(score.Value, column.Paper.FullMarks);
                        var paperGrade = Grading.For(percent);

                        <tr>
                            <td>
                                @column.Exam.Name
                                <div class="text-muted small">@column.Exam.ExamDate.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>@column.Paper.Subject?.Name</td>
                            <td class="text-end">@column.Paper.FullMarks.ToString("0.##")</td>
                            <td class="text-end">
                                @if (score == null)
                                {
                                    <span class="text-danger">Absent</span>
                                }
                                else
                                {
                                    @score.Value.ToString("0.##")
                                }
                            </td>
                            <td class="text-end">@percent.ToString("0.#")%</td>
                            <td class="text-center">
                                <span class="badge bg-@Grading.Colour(paperGrade.Letter)">@paperGrade.Letter</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="2">Total</td>
                        <td class="text-end">@fullMarks.ToString("0.##")</td>
                        <td class="text-end">@Model.Total.ToString("0.##")</td>
                        <td class="text-end">@Model.AveragePercent.ToString("0.#")%</td>
                        <td class="text-center">
                            <span class="badge bg-@Grading.Colour(grade.Letter)">@grade.Letter</span>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="row g-3 mb-4">
                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Merit position</div>
                        <div class="fs-4 fw-semibold">@Place(Model.Rank)</div>
                        <div class="text-muted small">of @classSize in the batch</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Papers sat</div>
                        <div class="fs-4 fw-semibold">@Model.PapersSat / @columns.Count</div>
                        <div class="text-muted small">absent counts as zero</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">Attendance</div>
                        <div class="fs-4 fw-semibold">@(attendanceRate == null ? "—" : $"{attendanceRate}%")</div>
                        <div class="text-muted small">@present of @days days</div>
                    </div>
                </div>

                <div class="col-sm-3">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="text-muted small">@thisMonth.ToString("MMMM") fees</div>
                        <div class="fs-4 fw-semibold @(due > 0 ? "text-danger" : "text-success")">
                            @(fee <= 0 ? "—" : due > 0 ? due.ToString("0.##") + " due" : "Paid")
                        </div>
                        <div class="text-muted small">@paid.ToString("0.##") of @fee.ToString("0.##") received</div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4 mt-2">
            <div class="col-md-8">
                <div class="text-muted small">Teacher's remark</div>
                <div class="border-bottom" style="height: 2.2rem;"></div>
                <div class="border-bottom mt-3" style="height: 2.2rem;"></div>
            </div>

            <div class="col-md-4 text-center align-self-end">
                <div class="border-top pt-1 mt-5">Guardian's signature</div>
            </div>
        </div>

    </div>
</div>
