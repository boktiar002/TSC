@model IReadOnlyList<TSC.Models.ProgressRow>

@{
    ViewData["Title"] = "Class Progress";

    var schoolClasses = (List<SchoolClass>)ViewBag.SchoolClasses;
    var exams = (List<Exam>)ViewBag.Exams;
    var chosen = (List<Exam>)ViewBag.Chosen;
    var schoolClassId = (int?)ViewBag.SchoolClassId;

    var chosenIds = chosen.Select(e => e.Id).ToHashSet();

    ViewBag.SchoolClass = schoolClasses.FirstOrDefault(b => b.Id == schoolClassId);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>Class progress</h1>
        <p class="text-muted mb-0">
            Every selected paper side by side, with totals, averages and merit position.
            A paper not sat counts as zero.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to exams
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="schoolClassId">Class</label>
                <select id="schoolClassId" name="schoolClassId" class="form-select" onchange="this.form.submit();">
                    @foreach (var b in schoolClasses)
                    {
                        <option value="@b.Id" selected="@(b.Id == schoolClassId)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Exams counted</label>

                @if (!exams.Any())
                {
                    <p class="text-muted mb-0">This class has no exams yet.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var exam in exams)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="examIds"
                                       value="@exam.Id" id="exam@(exam.Id)"
                                       checked="@chosenIds.Contains(exam.Id)" />
                                <label class="form-check-label" for="exam@(exam.Id)">
                                    @exam.Name
                                    <span class="text-muted">(@exam.ExamDate.ToString("dd MMM"))</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Apply
                </button>
                <span class="text-muted small ms-2">
                    Nothing ticked counts every exam in the class.
                </span>
            </div>
        </form>
    </div>
</div>

<partial name="_ProgressTable" model="Model" />
