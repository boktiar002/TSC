@{
    ViewData["Title"] = "Dashboard";

    var today = (DateOnly)ViewBag.Today;
    var presentToday = (int)ViewBag.PresentToday;
    var markedToday = (int)ViewBag.MarkedToday;
    var collected = (decimal)ViewBag.CollectedThisMonth;
    var thisMonth = (DateOnly)ViewBag.ThisMonth;
    var studentCount = (int)ViewBag.StudentCount;

    var name = User.Identity?.Name ?? "";
    var greeting = TSC.Data.Clock.Now.Hour < 12 ? "Good morning"
        : TSC.Data.Clock.Now.Hour < 17 ? "Good afternoon"
        : "Good evening";
}

<section class="tsc-statpanel">
    <div class="tsc-eyebrow">@today.ToString("dddd, d MMMM yyyy")</div>
    <h1 class="mb-1">@greeting</h1>
    <p class="tsc-statpanel-sub mb-0">
        Here is where the centre stands today.
    </p>

    <div class="tsc-stats">
        <a class="tsc-stat" asp-controller="Students" asp-action="Index">
            <div class="tsc-stat-value">@studentCount</div>
            <div class="tsc-stat-label">Students</div>
        </a>

        <a class="tsc-stat" asp-controller="Attendance" asp-action="Index">
            <div class="tsc-stat-value">@(markedToday == 0 ? "—" : presentToday.ToString())</div>
            <div class="tsc-stat-label">
                @(markedToday == 0 ? "Roll not called" : $"Present of {markedToday}")
            </div>
        </a>

        <a class="tsc-stat" asp-controller="Payments" asp-action="Index">
            <div class="tsc-stat-value">@collected.ToString("N0")</div>
            <div class="tsc-stat-label">@thisMonth.ToString("MMM") fees in</div>
        </a>

        <a class="tsc-stat" asp-controller="Teachers" asp-action="Index">
            <div class="tsc-stat-value">@ViewBag.TeacherCount</div>
            <div class="tsc-stat-label">Teachers</div>
        </a>
    </div>
</section>

<h2 class="h6 text-uppercase text-muted mb-2" style="letter-spacing:.08em">Quick actions</h2>

<div class="tsc-quick">
    <a class="tsc-quick-link" asp-controller="Attendance" asp-action="Index">
        <span class="tsc-quick-icon is-mint"><i class="bi bi-calendar2-check"></i></span>
        Take attendance
    </a>

    <a class="tsc-quick-link" asp-controller="Payments" asp-action="Create">
        <span class="tsc-quick-icon is-amber"><i class="bi bi-cash-coin"></i></span>
        Record a fee
    </a>

    <a class="tsc-quick-link" asp-controller="Exams" asp-action="Index">
        <span class="tsc-quick-icon"><i class="bi bi-clipboard-check"></i></span>
        Exams &amp; marks
    </a>

    <a class="tsc-quick-link" asp-controller="Students" asp-action="Create">
        <span class="tsc-quick-icon is-rose"><i class="bi bi-person-plus"></i></span>
        Add a student
    </a>
</div>

<div class="row g-3">

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><strong>Academics</strong></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="tsc-stat-label text-muted">Classes</div>
                        <div class="display-6 mb-1">@ViewBag.SchoolClassCount</div>
                        <a asp-controller="Classes" asp-action="Index" class="small">Manage classes</a>
                    </div>

                    <div class="col-6">
                        <div class="tsc-stat-label text-muted">Subjects</div>
                        <div class="display-6 mb-1">@ViewBag.SubjectCount</div>
                        <a asp-controller="Subjects" asp-action="Index" class="small">Manage subjects</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><strong>Portal access</strong></div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted mb-3">
                    Students and teachers sign in with the ID the centre gave them. Look a
                    login ID and password up here whenever a guardian asks.
                </p>

                <a asp-controller="Logins" asp-action="Index" class="btn btn-primary mt-auto align-self-start">
                    <i class="bi bi-key me-1"></i>Portal logins
                </a>
            </div>
        </div>
    </div>

</div>
