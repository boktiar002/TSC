@{
    ViewData["Title"] = "Admin Dashboard";

    // controller == null -> stat only, module not built yet
    var cards = new (string Title, int Count, string? Controller)[]
    {
        ("Students", (int)ViewBag.StudentCount, "Students"),
        ("Batches",  (int)ViewBag.BatchCount,   "Batches"),
        ("Teachers", (int)ViewBag.TeacherCount, "Teachers"),
        ("Subjects", (int)ViewBag.SubjectCount, "Subjects"),
    };
}

<h1>Admin Dashboard</h1>
<p class="text-muted">Welcome, @User.Identity?.Name</p>

<div class="row mt-4">
    @foreach (var card in cards)
    {
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100 @(card.Controller == null ? "text-muted" : "")">
                <div class="card-body">
                    <h5 class="card-title">@card.Title</h5>
                    <p class="display-6 mb-2">@card.Count</p>

                    @if (card.Controller != null)
                    {
                        <a asp-area="Admin" asp-controller="@card.Controller" asp-action="Index"
                           class="stretched-link">Manage @card.Title.ToLower()</a>
                    }
                    else
                    {
                        <small>Not built yet</small>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm mt-2">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">Today's attendance</h5>
            <small class="text-muted">Pick a batch and tick who showed up.</small>
        </div>

        <a asp-area="Admin" asp-controller="Attendance" asp-action="Index" class="btn btn-primary">
            Take attendance
        </a>

        <a asp-area="Admin" asp-controller="Exams" asp-action="Index" class="btn btn-outline-primary ms-2">
            Exams &amp; results
        </a>

        <a asp-area="Admin" asp-controller="Payments" asp-action="Index" class="btn btn-outline-primary ms-2">
            Fees
        </a>
    </div>
</div>
