@model IEnumerable<TSC.Models.Attendance>

@{
    ViewData["Title"] = "My Attendance";

    var student = (TSC.Models.Student)ViewBag.Student;
    var total = Model.Count();
    var present = Model.Count(a => a.IsPresent);
    var rate = total == 0 ? 0 : present * 100 / total;
}

<h1>My Attendance</h1>
<p class="text-muted">@student.StudentId &middot; @student.Batch?.Name</p>
<hr />

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Rate</h6>
                <p class="display-6 mb-0">@rate%</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Present</h6>
                <p class="display-6 mb-0">@present</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Days recorded</h6>
                <p class="display-6 mb-0">@total</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (total == 0)
        {
            <p class="text-muted mb-0">No attendance recorded for you yet.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Date</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.Date.ToString("ddd, dd MMM yyyy")</td>
                            <td>
                                @if (record.IsPresent)
                                {
                                    <span class="badge bg-success">Present</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Absent</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
