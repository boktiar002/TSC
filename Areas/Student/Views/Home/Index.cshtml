@model TSC.Models.Student

@{
    ViewData["Title"] = "My Dashboard";

    var rate = (int?)ViewBag.AttendanceRate;
    var daysRecorded = (int)ViewBag.DaysRecorded;
    var fee = (decimal)ViewBag.Fee;
    var due = (decimal)ViewBag.DueThisMonth;
    var paidThisMonth = (decimal)ViewBag.PaidThisMonth;
    var thisMonth = (DateOnly)ViewBag.ThisMonth;
    var examCount = (int)ViewBag.ExamCount;
    var notices = (IEnumerable<TSC.Models.Notice>)ViewBag.Notices;
}

<h1>@Model.FullName</h1>
<p class="text-muted">@Model.StudentId &middot; @Model.SchoolClass?.Name &middot; Class @Model.ClassLevel</p>
<hr />

<div class="row">

    <div class="col-md-4 mb-3">
        <a asp-action="Attendance" class="card shadow-sm h-100 text-decoration-none text-dark">
            <div class="card-body">
                <h6 class="text-muted">Attendance</h6>
                <p class="display-6 mb-0">@(rate == null ? "—" : $"{rate}%")</p>
                <small class="text-muted">@daysRecorded day@(daysRecorded == 1 ? "" : "s") recorded</small>
            </div>
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-action="Results" class="card shadow-sm h-100 text-decoration-none text-dark">
            <div class="card-body">
                <h6 class="text-muted">Exam results</h6>
                <p class="display-6 mb-0">@examCount</p>
                <small class="text-muted">exam@(examCount == 1 ? "" : "s") marked</small>
            </div>
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-action="Fees" class="card shadow-sm h-100 text-decoration-none text-dark">
            <div class="card-body">
                <h6 class="text-muted">@thisMonth.ToString("MMMM") fees</h6>

                @if (fee <= 0)
                {
                    <p class="display-6 mb-0">—</p>
                    <small class="text-muted">no fee set</small>
                }
                else if (due <= 0)
                {
                    <p class="display-6 mb-0 text-success">Paid</p>
                    <small class="text-muted">@paidThisMonth.ToString("0.##") received</small>
                }
                else
                {
                    <p class="display-6 mb-0 text-danger">@due.ToString("0.##")</p>
                    <small class="text-muted">due of @fee.ToString("0.##")</small>
                }
            </div>
        </a>
    </div>

</div>

<div class="card shadow-sm mt-2">
    <div class="card-header"><strong>Notices</strong></div>
    <div class="card-body">
        <partial name="_NoticeBoard" model="notices" />
    </div>
</div>
