@model IEnumerable<TSC.Models.Student>

@{
    var schoolClass = (TSC.Models.SchoolClass)ViewBag.SchoolClass;
    var mySubjects = (IEnumerable<TSC.Models.Subject>)ViewBag.MySubjects;

    ViewData["Title"] = schoolClass.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1>@schoolClass.Name</h1>
        <p class="text-muted mb-0">
            I teach:
            @foreach (var subject in mySubjects)
            {
                <span class="badge bg-light text-dark border me-1">@subject.Name</span>
            }
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <strong>Students</strong>
        <span class="badge bg-secondary float-end">@Model.Count()</span>
    </div>

    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No students in this class yet.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Student ID</th><th>Name</th><th>Guardian phone</th></tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FullName</td>
                            <td>@student.GuardianPhone</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
