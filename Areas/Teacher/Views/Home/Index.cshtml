@model TSC.Models.Teacher

@{
    ViewData["Title"] = "My Dashboard";

    var studentCount = (int)ViewBag.StudentCount;
    var schoolClassCount = (int)ViewBag.SchoolClassCount;
    var notices = (IEnumerable<TSC.Models.Notice>)ViewBag.Notices;
    var byClass = Model.ClassSubjects.GroupBy(bs => bs.SchoolClass!).OrderBy(g => g.Key.Name).ToList();

    var subjectCount = Model.ClassSubjects.Select(bs => bs.SubjectId).Distinct().Count();
    var firstName = Model.FullName.Split(' ').FirstOrDefault() ?? Model.FullName;
}

<section class="tsc-statpanel">
    <div class="tsc-eyebrow">
        @Model.TeacherId
        @if (!string.IsNullOrWhiteSpace(Model.Specialization)) { <text>&middot; @Model.Specialization</text> }
    </div>

    <h1 class="mb-1">Hello, @firstName</h1>
    <p class="tsc-statpanel-sub mb-0">Your classes, marks and roll call.</p>

    <div class="tsc-stats">
        <div class="tsc-stat">
            <div class="tsc-stat-value">@schoolClassCount</div>
            <div class="tsc-stat-label">Classes</div>
        </div>

        <div class="tsc-stat">
            <div class="tsc-stat-value">@studentCount</div>
            <div class="tsc-stat-label">Students</div>
        </div>

        <div class="tsc-stat">
            <div class="tsc-stat-value">@subjectCount</div>
            <div class="tsc-stat-label">Subject@(subjectCount == 1 ? "" : "s")</div>
        </div>

        <a class="tsc-stat" asp-action="Exams">
            <div class="tsc-stat-value"><i class="bi bi-arrow-right"></i></div>
            <div class="tsc-stat-label">Enter marks</div>
        </a>
    </div>
</section>

<div class="tsc-quick">
    <a class="tsc-quick-link" asp-action="Attendance">
        <span class="tsc-quick-icon is-mint"><i class="bi bi-calendar2-check"></i></span>
        Take attendance
    </a>

    <a class="tsc-quick-link" asp-action="Exams">
        <span class="tsc-quick-icon"><i class="bi bi-clipboard-check"></i></span>
        Enter marks
    </a>

    <a class="tsc-quick-link" asp-action="Progress">
        <span class="tsc-quick-icon is-amber"><i class="bi bi-trophy"></i></span>
        See results
    </a>

    <a class="tsc-quick-link" asp-action="Notices">
        <span class="tsc-quick-icon is-rose"><i class="bi bi-megaphone"></i></span>
        Notices
    </a>
</div>

<div class="card mb-3">
    <div class="card-header"><strong>What I teach</strong></div>
    <div class="card-body">

        @if (!byClass.Any())
        {
            <p class="text-muted mb-0">
                You aren't assigned to any class yet. The office assigns subjects to teachers
                from the class page.
            </p>
        }
        else
        {
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr><th>Class</th><th>Subjects</th><th class="text-end"></th></tr>
                </thead>
                <tbody>
                    @foreach (var group in byClass)
                    {
                        <tr>
                            <td><strong>@group.Key.Name</strong></td>
                            <td>
                                @foreach (var bs in group.OrderBy(x => x.Subject?.Name))
                                {
                                    <span class="badge bg-light text-dark border me-1">@bs.Subject?.Name</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Class" asp-route-id="@group.Key.Id"
                                   class="btn btn-sm btn-outline-primary">Students</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Notices</strong></div>
    <div class="card-body">
        <partial name="_NoticeBoard" model="notices" />
    </div>
</div>
